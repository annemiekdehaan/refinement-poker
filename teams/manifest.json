{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.1",
  "id": "0c355514-f609-4c49-8c28-376736180e73",
  "developer": {
    "name": "Annemiek de Haan",
    "websiteUrl": "https://github.com/annemiekdehaan/refinement-poker",
    "privacyUrl": "https://annemiekdehaan.github.io/refinement-poker/privacy.html",
    "termsOfUseUrl": "https://annemiekdehaan.github.io/refinement-poker/privacy.html"
  },
  "name": {
    "short": "Refinement Poker",
    "full": "Refinement Poker — estimate together"
  },
  "description": {
    "short": "Estimate stories together with hidden votes and a shared reveal.",
    "full": "Start a refinement session in your meeting, chat or channel. Everyone chooses a card independently; the facilitator reveals the votes together. Discuss differences, save agreed story points and export results as CSV. No account needed. Up to 12 participants; the facilitator keeps the app open. Requires a network that allows WebRTC."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#203B33",
  "configurableTabs": [
    {
      "configurationUrl": "https://annemiekdehaan.github.io/refinement-poker/config.html",
      "canUpdateConfiguration": true,
      "scopes": [
        "team",
        "groupChat"
      ],
      "context": [
        "channelTab",
        "privateChatTab",
        "meetingChatTab",
        "meetingDetailsTab",
        "meetingSidePanel"
      ]
    }
  ],
  "staticTabs": [
    {
      "entityId": "refinement-poker-home",
      "name": "Poker",
      "contentUrl": "https://annemiekdehaan.github.io/refinement-poker/",
      "websiteUrl": "https://annemiekdehaan.github.io/refinement-poker/",
      "scopes": [
        "personal"
      ]
    }
  ],
  "validDomains": [
    "annemiekdehaan.github.io",
    "0.peerjs.com"
  ]
}
